DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@localhost:5432/truck_routing
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production (applies when DJANGO_DEBUG=false)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://*.up.railway.app
# DJANGO_SECURE_SSL_REDIRECT=true       # set false only when serving plain HTTP (e.g. local docker run)
# FRONTEND_DIST_DIR=../frontend/dist    # built SPA served by Django; the Dockerfile sets this
# LOG_LEVEL=INFO

# Optional overrides (defaults are public, keyless endpoints)
# GEOCODING_URL=https://photon.komoot.io/api/
# ROUTING_PROVIDER=valhalla            # or "osrm" (then ROUTING_URL=https://router.project-osrm.org)
# ROUTING_URL=https://valhalla1.openstreetmap.de
# WEATHER_URL=https://api.open-meteo.com/v1/forecast
# HTTP_TIMEOUT_S=20
# HTTP_USER_AGENT=weather-truck-routing/1.0
# WEATHER_CACHE_TTL_S=1800

# Planning
# TRUCK_TARE_WEIGHT_LB=35000
# TRUCK_MAX_SPEED_MPH=65

# Rate limits (per client IP)
# THROTTLE_PLACES=60/min
# THROTTLE_PLAN=12/min
